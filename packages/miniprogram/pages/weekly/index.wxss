/* pages/weekly — 周报生成器 (v6.80)。视觉对齐 banwei/fortune 那套玻璃拟态。 */
.root { padding: 32rpx; min-height: 100vh; }

.header { margin-bottom: 32rpx; }
.hd-label {
  font-size: 22rpx; font-weight: 900; letter-spacing: 6rpx;
  color: #4ECDC4; text-transform: uppercase; margin-bottom: 8rpx;
}
.hd-sub { font-size: 24rpx; color: rgba(255,255,255,0.55); }
.pref-chip {
  display: inline-block; margin-top: 14rpx; padding: 8rpx 18rpx; border-radius: 999rpx;
  font-size: 20rpx; font-weight: 800; color: #FF4FA3;
  background: rgba(255,79,163,0.12); border: 2rpx solid rgba(255,79,163,0.3);
}

.card {
  padding: 28rpx; border-radius: 24rpx; margin-bottom: 24rpx;
  background: rgba(15,14,46,0.6);
  border: 2rpx solid rgba(78,205,196,0.25);
}
.in-label { font-size: 24rpx; font-weight: 800; color: rgba(255,255,255,0.8); margin-bottom: 14rpx; }
.in-box {
  width: 100%; min-height: 140rpx; box-sizing: border-box;
  padding: 20rpx; border-radius: 16rpx; font-size: 26rpx; color: #fff;
  background: rgba(255,255,255,0.05); border: 2rpx solid rgba(255,255,255,0.12);
}
.in-ph { color: rgba(255,255,255,0.3); }
.in-meta { text-align: right; font-size: 20rpx; color: rgba(255,255,255,0.4); margin: 10rpx 0 18rpx; }
.in-meta .ok { color: #4ECDC4; }

.cta {
  text-align: center; padding: 26rpx 0; border-radius: 20rpx;
  font-size: 28rpx; font-weight: 900; letter-spacing: 4rpx; color: #fff;
  background: linear-gradient(135deg, #4ECDC4, #4A90E2);
  box-shadow: 0 12rpx 36rpx rgba(78,205,196,0.28);
}
.cta.disabled { opacity: 0.4; }
.quota-hint { text-align: center; font-size: 18rpx; color: rgba(255,255,255,0.35); margin-top: 12rpx; }

.state { text-align: center; padding: 40rpx 0; color: rgba(255,255,255,0.4); }
.state.err { color: #ef4444; }

.skeleton {
  padding: 48rpx; border-radius: 24rpx; margin-bottom: 20rpx; text-align: center;
  font-size: 26rpx; color: rgba(255,255,255,0.35);
  background: rgba(255,255,255,0.04); border: 2rpx solid rgba(255,255,255,0.08);
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }

.result {
  padding: 28rpx; border-radius: 24rpx; margin-bottom: 20rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.10);
}
.result.broken { opacity: 0.55; border-color: rgba(239,68,68,0.3); }
.rs-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.rs-label { font-size: 28rpx; font-weight: 900; color: #fff; }
.rs-boost {
  font-size: 18rpx; font-weight: 800; color: #FFD700;
  padding: 4rpx 12rpx; border-radius: 999rpx;
  background: rgba(255,215,0,0.12); border: 2rpx solid rgba(255,215,0,0.3);
}
.rs-desc { font-size: 20rpx; color: rgba(255,255,255,0.45); margin-bottom: 14rpx; }
.rs-text { font-size: 26rpx; color: rgba(255,255,255,0.92); line-height: 1.7; }
.rs-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.rs-btn {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 14rpx;
  font-size: 24rpx; font-weight: 800; color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.06); border: 2rpx solid rgba(255,255,255,0.14);
}
.rs-btn.like.liked {
  color: #FF4FA3; background: rgba(255,79,163,0.12); border-color: rgba(255,79,163,0.4);
}

.share-btn {
  margin-top: 16rpx;
  background: rgba(176,134,255,0.16);
  color: #B086FF;
  font-size: 26rpx; font-weight: 800;
  letter-spacing: 4rpx;
  border-radius: 20rpx;
}
.share-btn::after { border: none; }

.off-canvas {
  position: fixed; left: -9999rpx; top: -9999rpx;
  width: 1080px; height: 1350px;
}

.footer { margin-top: 24rpx; }
.ft-line { text-align: center; font-size: 20rpx; color: rgba(255,255,255,0.35); }
