<view class="root">
  <!-- ============ 详情(播放)视图 ============ -->
  <block wx:if="{{active}}">
    <view class="back" bindtap="backToList">← 段子库</view>

    <view class="bit-card">
      <view class="bit-title">{{active.title}}</view>
      <view class="bit-chips">
        <text class="chip">{{active.personaCn}}</text>
        <text class="chip">{{active.tagCn}}</text>
        <text class="chip dim">⏱ {{active.durationSec}}s</text>
        <text class="chip dim">❤️ {{active.likes}}</text>
      </view>

      <!-- 播放控制 -->
      <view class="play-cta {{playState === 'playing' ? 'playing' : ''}}" bindtap="onPlay">
        <block wx:if="{{playState === 'idle'}}">▶️ AI 嘴替开讲</block>
        <block wx:elif="{{playState === 'loading'}}">⏳ 嗓子热身中...</block>
        <block wx:elif="{{playState === 'playing'}}">⏸ 正在开麦 · 点击暂停</block>
        <block wx:elif="{{playState === 'done'}}">🔁 再听一遍</block>
        <block wx:else>📖 语音暂不可用 · 文字版照样好笑</block>
      </view>
      <view class="progress" wx:if="{{playState === 'playing' || playState === 'done'}}">
        <view class="progress-fill" style="width: {{progress}}%;" />
      </view>

      <!-- 全文 -->
      <view class="bit-text">{{active.text}}</view>
    </view>

    <button open-type="share" class="share-btn">📨 把这段发给最有班味的同事</button>
  </block>

  <!-- ============ 列表视图 ============ -->
  <block wx:else>
    <view class="header">
      <view class="hd-label">🎤 班味单口 · TALKSHOW</view>
      <view class="hd-sub">AI 鼠人替你讲段子 · 按热度排 · 点开听</view>
    </view>

    <block wx:if="{{loading}}">
      <view class="state">⏳ 段子搬运中...</view>
    </block>
    <block wx:elif="{{err}}">
      <view class="state err">⚠ {{err}}\n配置 app.js → globalData.apiBase 指向真服务器后重试.</view>
    </block>
    <block wx:elif="{{detailLoading}}">
      <view class="state">⏳ 拉全文中...</view>
    </block>
    <block wx:else>
      <view class="bit-item" wx:for="{{list}}" wx:key="id" bindtap="openBit" data-id="{{item.id}}">
        <view class="bi-main">
          <view class="bi-title">{{item.title}}</view>
          <view class="bi-meta">{{item.personaCn}} · {{item.tagCn}} · ⏱{{item.durationSec}}s</view>
        </view>
        <view class="bi-stats">
          <view>❤️ {{item.likes}}</view>
          <view class="dim">▶ {{item.plays}}</view>
        </view>
      </view>
    </block>

    <view class="footer">
      <view class="ft-line">💡 投稿自己的段子 / 让 AI 吐槽你的话题 → H5 端「班味单口」</view>
    </view>
  </block>
</view>
