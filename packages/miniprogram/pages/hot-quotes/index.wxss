.root { padding: 32rpx; min-height: 100vh; }
.header { margin-bottom: 32rpx; }
.hd-label {
  font-size: 22rpx; font-weight: 900; letter-spacing: 6rpx;
  color: #FF4FA3; text-transform: uppercase; margin-bottom: 8rpx;
}
.hd-sub { font-size: 24rpx; color: rgba(255,255,255,0.55); }

.submit-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255,79,163,0.06);
  border: 2rpx solid rgba(255,79,163,0.35);
  margin-bottom: 32rpx;
}
.ta {
  width: 100%; box-sizing: border-box;
  padding: 16rpx; min-height: 100rpx;
  background: rgba(15,14,46,0.6);
  border: 2rpx solid rgba(255,79,163,0.3);
  border-radius: 12rpx;
  font-size: 28rpx; color: #f4f4ff;
  font-family: inherit;
}
.meta-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 16rpx;
}
.meta { font-size: 22rpx; color: rgba(255,255,255,0.45); }

.submit {
  background: linear-gradient(135deg, #FF4FA3 0%, #7c3aed 100%);
  color: #fff; font-size: 26rpx; font-weight: 900;
  padding: 12rpx 24rpx; border-radius: 12rpx;
  letter-spacing: 2rpx; line-height: 1.4;
  border: none;
  min-width: 160rpx;
}
.submit[disabled] { opacity: 0.55; }
.submit.ok { background: #22c55e; }
.submit.cap { background: rgba(239,68,68,0.6); }

.recent-header {
  font-size: 22rpx; font-weight: 800; letter-spacing: 4rpx;
  color: rgba(255,255,255,0.4); text-transform: uppercase;
  margin-bottom: 16rpx;
}

.state {
  padding: 64rpx 0; text-align: center;
  font-size: 26rpx; color: rgba(255,255,255,0.4);
}
.state.err { color: #ef4444; }

.recent-list { display: flex; flex-direction: column; gap: 12rpx; }
.recent-item {
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.06);
  border-radius: 12rpx;
}
.rt-text { font-size: 26rpx; color: rgba(248,244,227,0.85); line-height: 1.5; }
.rt-meta { font-size: 20rpx; color: rgba(255,255,255,0.4); margin-top: 6rpx; }

.footer {
  margin-top: 48rpx;
  padding: 24rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 16rpx;
}
.ft-line {
  font-size: 22rpx; color: rgba(255,255,255,0.45);
  margin-bottom: 6rpx; line-height: 1.6;
}

/* v6.80 — 周报生成器入口卡 */
.weekly-entry {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 24rpx; padding: 24rpx 28rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(78,205,196,0.18), rgba(74,144,226,0.10));
  border: 2rpx solid rgba(78,205,196,0.35);
}
.we-left { display: flex; align-items: center; gap: 20rpx; }
.we-emoji { font-size: 56rpx; line-height: 1; }
.we-title { font-size: 28rpx; font-weight: 900; color: #fff; }
.we-sub { font-size: 20rpx; color: rgba(255,255,255,0.55); margin-top: 4rpx; }
.we-arrow { font-size: 32rpx; color: #4ECDC4; font-weight: 900; }
