/* pages/fortune — 班味占卜 (v6.79)。视觉对齐 banwei 那套玻璃拟态 + 紫底。 */
.root { padding: 32rpx; min-height: 100vh; }

.header { margin-bottom: 32rpx; }
.hd-label {
  font-size: 22rpx; font-weight: 900; letter-spacing: 6rpx;
  color: #B086FF; text-transform: uppercase; margin-bottom: 8rpx;
}
.hd-sub { font-size: 24rpx; color: rgba(255,255,255,0.55); }

.state { text-align: center; padding: 80rpx 0; color: rgba(255,255,255,0.4); }
.state.err { color: #ef4444; white-space: pre-line; }

/* —— 翻牌 —— */
.card-stage { perspective: 1200rpx; margin-bottom: 24rpx; }
.card-flip {
  position: relative; width: 100%; aspect-ratio: 4 / 5;
  transform-style: preserve-3d; transform: rotateY(180deg);
  transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
}
.card-flip.revealed { transform: rotateY(0deg); }
.face {
  position: absolute; inset: 0; border-radius: 36rpx; overflow: hidden;
  backface-visibility: hidden;
}
.back {
  transform: rotateY(180deg);
  background: radial-gradient(circle at 50% 35%, #7c3aed 0%, #1a0d35 65%, #050510 100%);
  border: 3rpx solid rgba(255,255,255,0.18);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.back-sigil { font-size: 140rpx; opacity: 0.85; }
.back-brand {
  position: absolute; bottom: 36rpx; left: 0; right: 0; text-align: center;
  font-size: 20rpx; letter-spacing: 8rpx; color: rgba(255,255,255,0.4);
}
.front {
  border: 3rpx solid; padding: 40rpx;
  display: flex; flex-direction: column;
}
.vibe-row {
  display: flex; justify-content: space-between;
  font-size: 20rpx; font-weight: 900; letter-spacing: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.55);
}
.vibe-bar {
  margin-top: 14rpx; height: 10rpx; border-radius: 8rpx; overflow: hidden;
  background: rgba(0,0,0,0.25);
}
.vibe-fill { height: 100%; border-radius: 8rpx; transition: width 0.8s ease-out; }
.hero { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.hero-emoji { font-size: 170rpx; line-height: 1; margin-bottom: 20rpx; filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,0.35)); }
.hero-title { font-size: 56rpx; font-weight: 900; color: #fff; text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.4); }
.hero-sub { font-size: 26rpx; color: rgba(255,255,255,0.85); margin-top: 10rpx; line-height: 1.5; }
.stamp {
  text-align: center; font-size: 18rpx; letter-spacing: 6rpx;
  color: rgba(255,255,255,0.75); text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}

/* —— 忠告 / 微行动 —— */
.block {
  padding: 28rpx; border-radius: 24rpx; margin-bottom: 20rpx;
  background: rgba(255,255,255,0.04);
  border: 2rpx solid rgba(255,255,255,0.10);
}
.block.action {
  background: linear-gradient(135deg, rgba(255,184,76,0.10), rgba(255,85,136,0.06));
  border-color: rgba(255,184,76,0.30);
}
.bk-label { font-size: 20rpx; font-weight: 900; letter-spacing: 5rpx; margin-bottom: 10rpx; }
.bk-label.gold { color: #ffd58a; }
.bk-label.cyan { color: #9be6ff; }
.bk-text { font-size: 26rpx; color: rgba(255,255,255,0.9); line-height: 1.7; }
.bk-text.bold { font-weight: 800; color: rgba(255,255,255,0.95); }

.share-hint { text-align: center; font-size: 20rpx; color: rgba(255,255,255,0.65); margin: 24rpx 0 12rpx; }
.share-hint .tag { color: #ffd58a; font-weight: 900; }

.cta {
  text-align: center; padding: 26rpx 0; border-radius: 20rpx;
  font-size: 28rpx; font-weight: 900; letter-spacing: 4rpx; color: #fff;
  background: linear-gradient(135deg, #ff5588, #7c3aed);
  box-shadow: 0 12rpx 36rpx rgba(124,58,237,0.32);
}
.share-btn {
  margin-top: 16rpx;
  background: rgba(176,134,255,0.16);
  color: #B086FF;
  font-size: 26rpx; font-weight: 800;
  letter-spacing: 4rpx;
  border-radius: 20rpx;
}
.share-btn::after { border: none; }
.comeback { text-align: center; font-size: 20rpx; color: rgba(255,255,255,0.45); margin-top: 20rpx; }

.off-canvas {
  position: fixed; left: -9999rpx; top: -9999rpx;
  width: 1080px; height: 1350px;
}
