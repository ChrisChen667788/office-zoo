<view class="root">
  <view class="header">
    <view class="hd-label">🔮 班味占卜 · OFFICE ZOO TAROT</view>
    <view class="hd-sub">{{date ? date + ' · 每天 UTC 0 点重洗' : '一天一张, 同一天重进同一张'}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="state">⏳ 卡牌正在洗中...</view>
  </block>

  <block wx:elif="{{err}}">
    <view class="state err">⚠ {{err}}\n配置 app.js → globalData.apiBase 指向真服务器后重试.</view>
  </block>

  <block wx:elif="{{card}}">
    <!-- 牌:背面(未翻) / 牌面(翻开)。CSS rotateY 翻转,套 H5 端同节奏。 -->
    <view class="card-stage">
      <view class="card-flip {{revealed ? 'revealed' : ''}}">
        <!-- 牌背 -->
        <view class="face back">
          <view class="back-sigil">🔮</view>
          <view class="back-brand">OFFICE ZOO TAROT</view>
        </view>
        <!-- 牌面 -->
        <view class="face front" style="background: linear-gradient(160deg, {{card.gradient[0]}} 0%, {{card.gradient[1]}} 100%); border-color: {{tierColor}}88;">
          <view class="vibe-row" style="color: #fff;">
            <text>{{tierLabel}}</text>
            <text>运势 · {{card.vibeScore}}</text>
          </view>
          <view class="vibe-bar">
            <view class="vibe-fill" style="width: {{card.vibeScore}}%; background: {{tierColor}};" />
          </view>
          <view class="hero">
            <view class="hero-emoji">{{card.emoji}}</view>
            <view class="hero-title">{{card.title}}</view>
            <view class="hero-sub">{{card.subtitle}}</view>
          </view>
          <view class="stamp">OFFICE ZOO · {{date}}</view>
        </view>
      </view>
    </view>

    <block wx:if="{{revealed}}">
      <view class="block">
        <view class="bk-label gold">✦ 今日忠告</view>
        <view class="bk-text">{{card.advice}}</view>
      </view>
      <view class="block action">
        <view class="bk-label cyan">✦ 5 分钟微行动</view>
        <view class="bk-text bold">{{card.microAction}}</view>
      </view>

      <view class="share-hint">截图发朋友圈 / 小红书 → 标签 <text class="tag">#班味占卜</text></view>
      <view class="cta" bindtap="onShareCard">📤 生成 1080×1350 分享卡</view>
      <button open-type="share" class="share-btn">📨 转发给朋友</button>
      <view class="comeback">✦ 明天的牌 · 子时(UTC 00:00) 重洗</view>
    </block>
  </block>

  <!-- off-screen canvas for the 1080x1350 share poster (banwei 模板) -->
  <canvas type="2d" id="share-canvas" class="off-canvas"></canvas>
</view>
