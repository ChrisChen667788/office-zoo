/* v6.43 P3 — 技术架构页样式. 深紫宇宙底 + 金/青 accent,与品牌一致. */
.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  background:
    radial-gradient(ellipse at 30% 12%, rgba(176,134,255,0.22) 0%, transparent 48%),
    radial-gradient(ellipse at 80% 88%, rgba(255,215,0,0.12) 0%, transparent 52%),
    #0a0a1e;
  box-sizing: border-box;
}

.hero { margin-bottom: 24rpx; }
.title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #FFD700;
  letter-spacing: 1rpx;
}
.sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
}

.diagram {
  width: 100%;
  border-radius: 20rpx;
  border: 1rpx solid rgba(78,205,196,0.3);
  background: #06061a;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.4);
}

.flow {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.step {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.06);
  font-size: 25rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.5;
}
.dot {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4ECDC4;
  font-weight: 900;
}
.hl { color: #FFD700; font-weight: 700; }

.note {
  margin-top: 30rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(78,205,196,0.06);
  border: 1rpx solid rgba(78,205,196,0.25);
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  line-height: 1.7;
}
.note .link {
  display: block;
  margin-top: 6rpx;
  color: #4ECDC4;
  font-weight: 600;
}

/* v6.44 P3 — 公司主题包 emoji 头像展示 */
.pack {
  margin-top: 30rpx;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255,215,0,0.06);
  border: 1rpx solid rgba(255,215,0,0.28);
}
.pack-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #FFD700;
}
.pack-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
}
.avatars {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.av {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  border-radius: 50%;
  background: rgba(15,14,46,0.9);
  border: 1rpx solid rgba(255,255,255,0.12);
}
.pack-cta {
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 700;
  color: #0a0a1e;
  background: linear-gradient(135deg, #FFD700 0%, #FFA947 100%);
}
