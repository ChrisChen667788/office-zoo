{
  "name": "furball-arena",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm -w @furball/server run dev",
    "dev:client": "npm -w @furball/client run dev",
    "build": "npm -w @furball/client run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "changelog": "git-cliff --unreleased --output /tmp/cliff-unreleased.md && echo 'wrote /tmp/cliff-unreleased.md — review then splice into docs/CHANGELOG.md above latest section'",
    "changelog:full": "git-cliff --output docs/CHANGELOG.auto.md && echo 'wrote docs/CHANGELOG.auto.md (auto regen from scratch — NOT the curated docs/CHANGELOG.md)'",
    "hooks:install": "bash scripts/install-hooks.sh",
    "gen:mp-arch": "node scripts/gen-mp-architecture.mjs",
    "gen:screenshots": "node scripts/capture_screenshots.mjs && node scripts/capture_game_screens.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "git-cliff": "^2.13.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
