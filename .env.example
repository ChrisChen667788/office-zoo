# ========== OFFICE ZOO · 环境变量示例 ==========
# 复制此文件到 .env,然后填上自己的 key。
# 严格不要把 .env 提交到任何公开仓库。

# ========== LLM 推理 ==========
# OpenAI 兼容代理(推荐青云聚合 / VectorEngine / 任意 OpenAI 兼容上游)
OPENAI_API_KEY=your_openai_compatible_key_here
OPENAI_BASE_URL=https://api.qingyuntop.top/v1
OPENAI_MODEL=gpt-4o-mini

# v3.5.0 — squad director 专用 model(攒局编剧 5 幕剧的那一次 LLM 调用)。
# 这是产品里最高价值的 LLM call(一次出 1800 token,产出全部 5 幕剧
# 用户截图疯传),值得用最强 model。其他 LLM 路径仍按 OPENAI_MODEL 跑
# 便宜的 gpt-4o-mini。默认 claude-opus-4-7;不可用时通过 SCORING 失败
# fallback 自动降级到 MiniMax-M2 + 模板剧。可选值(看你的 API 上游
# 支持什么 — 用 GET /v1/models 查):claude-opus-4-7 /
# claude-sonnet-4-5-20250929 / claude-sonnet-4-6 / gpt-5 / gpt-5.5 /
# gpt-4.5-turbo / deepseek-r2 等。
SQUAD_DIRECTOR_MODEL=claude-opus-4-7

# v6.51 P2 — A/B 对照 model(仅 `npm -w @furball/server run squad:ab` 用)。
# 把同一桌 roster 同时跑 SQUAD_DIRECTOR_MODEL(control)和这个(variant),
# 两份 5 幕剧本并排打印 + 存 /tmp/squad-ab-{A,B}.json,人工评演出效果后再
# 决定要不要把 SQUAD_DIRECTOR_MODEL 换成更便宜的 sonnet。默认 sonnet。
SQUAD_DIRECTOR_MODEL_B=claude-sonnet-4-7

# v3.7.0 — fired-mode HR dialogue 专用 model(裁了么对话里 HR 的每一句话)。
# HR 回复是用户体验的核心:每局 ~10 个 round-trip,每个 ~400 token,
# 用 premium 模型让 HR 话更精准、archetype weak-spot PUA 更狠。
# 注意:这是高频调用(每个 user turn 都触发一次),premium 模型成本
# 显著高于 gpt-4o-mini。如果在意成本可以改回 gpt-4o-mini 或 deepseek-r2。
# scoring + suggestions 仍走 OPENAI_MODEL 的便宜路径。
FIRED_HR_MODEL=claude-opus-4-7

# 青云聚合(同时用作图像 + TTS 备路)
QINGYUN_API_KEY=your_qingyun_key_here
QINGYUN_BASE_URL=https://api.qingyuntop.top/v1

# ========== Minimax(主路 TTS + LLM 备路 + 图像备路)==========
# 文档:https://platform.minimaxi.com/docs
MINIMAX_API_KEY=your_minimax_key_here
# GroupId 是可选的;部分代理 key 不需要
MINIMAX_GROUP_ID=

# 可选:覆盖默认 model 选型
# MINIMAX_TTS_MODEL=speech-2.8-hd
# MINIMAX_LLM_MODEL=MiniMax-M2
# MINIMAX_IMAGE_URL=https://api.minimaxi.com/v1/image_generation

# ========== 支付 · Stripe (v6.51 P3) ==========
# 全部留空 = 关闭真实支付,前端自动回落到 v1.0 的 demo checkout(只翻
# localStorage 标记,清楚标注"非真实扣款")。要接真支付时:用 Stripe
# 控制台建 2 个订阅 Price(月付/年付),填下面。上线前一律先用 test key
# (sk_test_… / whsec_…)。本服务永远不接触卡号 —— 卡号在 Stripe 托管的
# Checkout 页输入。
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx          # Stripe CLI / Dashboard webhook 签名密钥
# STRIPE_PRICE_MONTHLY=price_xxx           # 月付订阅 Price id
# STRIPE_PRICE_ANNUAL=price_xxx            # 年付订阅 Price id
# STRIPE_SUCCESS_URL=https://your-domain/premium?checkout=success
# STRIPE_CANCEL_URL=https://your-domain/premium?checkout=cancel

# ========== 邮件 · 班味 Wrapped 订阅 (v6.51 P4) ==========
# 留空 = 订阅照常入库,但发信走 console 兜底(只打日志,不真发)。要真发
# 数字年终回顾邮件:填 Resend key + 发件人。也可换任意 provider —— 只需改
# services/emailSender.ts 一个函数。
# RESEND_API_KEY=re_xxx
# WRAPPED_FROM_EMAIL=OFFICE ZOO <wrapped@your-domain.com>

# ========== 服务端口 ==========
PORT=3100
WS_PORT=3101
NODE_ENV=development

# ========== 部署形态 / 安全 (v6.162) ==========
# local(默认)= 本机开发 / 自部署,行为与以前一致;hosted = 公网托管(收紧来源、信任一层反向代理等)。
# DEPLOY_PROFILE=local

# 允许跨域调用 API 的前端来源,逗号分隔的完整 origin。同源请求始终放行,不用写。
# 不设置时:local 放行本机回环地址的任意端口;hosted 只放行同源。
# ALLOWED_ORIGINS=https://zoo.example.com

# 前面有几层可信反向代理(决定从 X-Forwarded-For 的哪一项取客户端 IP,用于限流)。
# 不设置时 local=0(直接用连接地址)、hosted=1。代理层数写多了,客户端就能伪造 IP 绕过限流。
# TRUST_PROXY_HOPS=1

# 批量清空 AI 记忆(不限定用户)的管理口令,随机串 ≥ 16 位。不设置 = 批量清空一律拒绝;
# 用户在设置页删除「自己的」记忆不需要它。
# MEMORY_ADMIN_TOKEN=

# POST /api/tts/generate 每个 IP 每小时的次数上限(对局内语音走 Socket,不受影响)。
# TTS_RATE_LIMIT_PER_HOUR=120

# 模型 key 模式(v6.167):server = 用本文件里的 key(本机自部署默认);byok = 服务器不提供模型 API,
# 访客必须在页面里配置自己的 key(DEPLOY_PROFILE=hosted 时默认,且即使本文件里有 key 也不会用)。
# 不论哪种模式,访客在页面里配了自己的 key 都优先用访客的。
# LLM_KEY_MODE=server

# 模型设置面板里的「其他 OpenAI 兼容接口」(自填 base URL)。hosted 默认关闭(防 SSRF);
# 打开后只允许 https 且解析结果必须全是公网地址。
# BYOK_ALLOW_CUSTOM_BASE_URL=0

# 访问统计(v6.163,可选):自部署 Umami 的脚本地址与站点 id。两个都配好才会在页面里加载统计脚本;
# 不配置 = 页面不发出任何第三方统计请求。脚本地址须为 https。
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# 服务端 JSON 数据目录(对局回放、关系网、统计等)。Docker 里指向挂载的数据卷。
# 不设置时用 packages/server/data/。
# FURBALL_DATA_DIR=/data

# ========== Maker / admin (v6.11) ==========
# Talkshow UGC 审核管理员 token. 任意长度 ≥ 16 的随机串. Maker 端 /maker
# 页 fetch /api/talkshow/maker/* 时通过 X-Maker-Token header 验证.
# 不设置 = 关闭 maker 路由 (所有 GET/POST 返回 503).
MAKER_TOKEN=please_set_a_random_string_here_at_least_16_chars
